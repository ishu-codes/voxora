# Copy to infra/.env and replace the provider credentials before starting.
API_PORT=8000
WEB_PORT=3000

# This URL is compiled into the browser bundle. It must be reachable from the
# browser, not from inside the Docker network.
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

APP_NAME=Voxora
VERSION=0.1.0
LOG_LEVEL=INFO

SARVAM_API_KEY=
SARVAM_WS_URL=wss://api.sarvam.ai
STT_MODEL=saaras:v3-realtime
STT_LANGUAGE=en-IN
STT_STREAM_TYPE=fast
STT_MODE=transcribe

LLM_PROVIDER=auto
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=320

TTS_MODEL=bulbul:v3
TTS_VOICE=shubh
TTS_LANGUAGE=en-IN
TTS_SAMPLE_RATE=22050
TTS_SPEED=1.0
TTS_TEMPERATURE=0.6

# Production must set a long random value. Backend rate limiting remains active
# with an ephemeral per-process secret when this is blank.
RATE_LIMIT_SECRET=
TRUST_PROXY_HEADERS=false
ALLOWED_UNLIMITED=
RATE_LIMIT_MAX_SESSION_SECONDS=900
PLATFORM_MAX_TURNS=10
RATE_LIMIT_PLATFORM_TURNS_HOUR=10
RATE_LIMIT_PLATFORM_TURNS_DAY=240
