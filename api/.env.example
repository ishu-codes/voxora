# --- Audio / transport ---
CORS_ORIGINS=http://localhost:3000
# INFO logs a readable turn trace; DEBUG adds provider frames and every PCM chunk.
LOG_LEVEL=INFO

# --- Sarvam AI (speech to text + text to speech) ---
# Create a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_WS_URL=wss://api.sarvam.ai

# --- Speech to text (Saaras realtime WebSocket) ---
# saaras:v3-realtime (default) or saaras:v4
STT_MODEL=saaras:v3-realtime
# BCP-47 code or "auto" for language detection
STT_LANGUAGE=en-IN
# fast | balanced | simulated
STT_STREAM_TYPE=fast
# transcribe | translate | verbatim | translit | codemix
STT_MODE=transcribe
STT_TIMEOUT_S=30

# --- LLM ---
# auto | echo | openai | ollama | groq | vllm | openai-compatible
LLM_PROVIDER=auto
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=320
LLM_TIMEOUT_S=60
# DeepSeek example:
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
# Ollama example:
#   LLM_PROVIDER=ollama
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.2
#   LLM_API_KEY=ollama

# --- Text to speech (Bulbul streaming WebSocket) ---
# bulbul:v3 (default) or bulbul:v4-flash
TTS_MODEL=bulbul:v3
# bulbul:v3 speakers include shubh, ritu, priya, neha, rahul, simran, kavya
TTS_VOICE=shubh
TTS_LANGUAGE=en-IN
# 8000 | 16000 | 22050 | 24000
TTS_SAMPLE_RATE=22050
TTS_SPEED=1.0
TTS_TEMPERATURE=0.6
TTS_TIMEOUT_S=60

# --- Voice activity detection / turn taking ---
VAD_THRESHOLD=0.014
VAD_START_FRAMES=3
VAD_END_SILENCE_MS=650
VAD_PRE_ROLL_MS=300
VAD_MAX_UTTERANCE_MS=30000

# --- Limits ---
MAX_HISTORY_MESSAGES=24
MAX_OUTPUT_QUEUE=256
STORE_RECENT_TURNS=500
# Turns allowed per WebSocket session when the platform keys are used. Users
# who bring their own Sarvam key and OpenAI-compatible endpoint are unlimited.
PLATFORM_MAX_TURNS=20
