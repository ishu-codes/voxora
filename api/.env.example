# --- Audio / transport ---
CORS_ORIGINS=http://localhost:3000
# INFO logs a readable turn trace; DEBUG adds provider frames and every PCM chunk.
LOG_LEVEL=INFO

# Gnani API KEY
GNANI_API_KEY=

# --- Sarvam AI (optional speech to text + text to speech) ---
# Create a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_WS_URL=wss://api.sarvam.ai

# --- Speech to text ---
# whisper (local) | faster-whisper | sarvam | gnani
STT_PROVIDER=whisper
# auto or a Whisper language code such as en, hi
WHISPER_LANGUAGE=auto

# Sarvam Saaras settings, used when STT_PROVIDER=sarvam
# saaras:v3-realtime (default) or saaras:v4
STT_MODEL=saaras:v3-realtime
# BCP-47 code or "auto" for language detection
STT_LANGUAGE=en-IN
# fast | balanced | simulated
STT_STREAM_TYPE=fast
# transcribe | translate | verbatim | translit | codemix
STT_MODE=transcribe
STT_TIMEOUT_S=30

# Gnani Prisma v2.5 (used when STT_PROVIDER=gnani or selected in the app)
GNANI_STT_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_STT_MODEL=prisma-v2.5
GNANI_STT_LANGUAGE=hi-IN
# verbatim preserves spoken words; transcribe enables Gnani number formatting.
GNANI_STT_FORMAT=verbatim

# --- LLM ---
# auto | echo | openai | ollama | groq | vllm | openai-compatible
LLM_PROVIDER=auto
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=320
LLM_TIMEOUT_S=60
# DeepSeek example:
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
# Ollama example:
#   LLM_PROVIDER=ollama
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.2
#   LLM_API_KEY=ollama

# --- Text to speech (Bulbul streaming WebSocket) ---
# sarvam | gnani
TTS_PROVIDER=sarvam
# bulbul:v3 (default) or bulbul:v4-flash
TTS_MODEL=bulbul:v3
# bulbul:v3 speakers include shubh, ritu, priya, neha, rahul, simran, kavya
TTS_VOICE=shubh
TTS_LANGUAGE=en-IN
# 8000 | 16000 | 22050 | 24000
TTS_SAMPLE_RATE=22050
TTS_SPEED=1.0
TTS_TEMPERATURE=0.6
TTS_TIMEOUT_S=60

# Gnani Timbre v2.5 (used when TTS_PROVIDER=gnani or selected in the app)
GNANI_TTS_URL=wss://api.vachana.ai/api/v1/tts
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Poorvi
GNANI_TTS_LANGUAGE=hi-en

# Provider calls run one at a time and retry only transient failures.
PROVIDER_RETRY_ATTEMPTS=3
PROVIDER_RETRY_BASE_MS=750

# --- Benchmark-only overrides ---
# Model IDs and temperatures live in api/config.yaml. These only select secrets
# and optional deployment overrides.
WHISPER_ENABLED=false
WHISPER_API_KEY=
WHISPER_BASE_URL=https://api.openai.com/v1
BENCHMARK_NETWORK_REGION=Asia/Kolkata

# --- Public demo limits ---
DEMO_CODE=
DEMO_SESSIONS_PER_IP_HOUR=5
DEMO_DAILY_SESSION_CAP=100

# --- Voice activity detection / turn taking ---
VAD_THRESHOLD=0.014
VAD_START_FRAMES=3
VAD_END_SILENCE_MS=650
VAD_PRE_ROLL_MS=300
VAD_MAX_UTTERANCE_MS=30000

# --- Limits ---
MAX_HISTORY_MESSAGES=24
MAX_OUTPUT_QUEUE=256
STORE_RECENT_TURNS=500
# Queries allowed per WebSocket session when the platform keys are used. Users
# who bring their own Sarvam key and OpenAI-compatible endpoint are unlimited.
PLATFORM_MAX_TURNS=10

# --- Abuse controls ---
# Server-side HMAC key for pseudonymous device/IP fingerprints. Set this to a
# long random value in production; never expose it to the browser.
RATE_LIMIT_SECRET=
RATE_LIMIT_ENABLED=true
# Reject missing Origins, command-line User-Agents, WebDriver sessions and
# connections that omit the browser fingerprint payload.
REQUIRE_BROWSER_CLIENT=true
# Enable only when the API is behind a trusted reverse proxy that overwrites
# X-Forwarded-For / X-Real-IP.
TRUST_PROXY_HEADERS=false
# Comma-separated IP addresses or CIDR ranges that bypass all rate limits.
# Leave empty in production unless a specific trusted network needs access.
ALLOWED_UNLIMITED=
RATE_LIMIT_IP_ATTEMPTS_10M=30
RATE_LIMIT_IP_ATTEMPTS_DAY=200
RATE_LIMIT_IDENTITY_ATTEMPTS_10M=5
RATE_LIMIT_IDENTITY_SESSIONS_HOUR=10
RATE_LIMIT_IDENTITY_SESSIONS_DAY=20
# Shared-platform queries are counted across reconnects by both the hashed
# device identity and caller IP. The hourly limit is the user-facing quota.
RATE_LIMIT_PLATFORM_TURNS_HOUR=10
RATE_LIMIT_PLATFORM_TURNS_DAY=240
RATE_LIMIT_STT_CHARS_HOUR=30000
RATE_LIMIT_STT_CHARS_DAY=120000
RATE_LIMIT_LLM_CHARS_HOUR=30000
RATE_LIMIT_LLM_CHARS_DAY=120000
RATE_LIMIT_LLM_TOKENS_HOUR=8000
RATE_LIMIT_LLM_TOKENS_DAY=32000
RATE_LIMIT_TTS_CHARS_HOUR=30000
RATE_LIMIT_TTS_CHARS_DAY=120000
RATE_LIMIT_MAX_CONCURRENT_IDENTITY=1
RATE_LIMIT_MAX_SESSION_SECONDS=900
