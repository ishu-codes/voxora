# --- Audio / transport ---
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Speech to text ---
# auto | browser | openai | faster-whisper
# auto: hosted key if present, then a locally installed faster-whisper model,
# otherwise the browser's own recognizer.
STT_PROVIDER=auto
STT_MODEL=whisper-1
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_LANGUAGE=
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# --- LLM ---
# auto | echo | openai | ollama | groq | vllm | openai-compatible
LLM_PROVIDER=auto
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=320
LLM_TIMEOUT_S=60
# Ollama example:
#   LLM_PROVIDER=ollama
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.2
#   LLM_API_KEY=ollama

# --- Text to speech ---
# auto | browser | openai
TTS_PROVIDER=auto
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_SAMPLE_RATE=24000
TTS_SPEED=1.0

# A single OpenAI key can back all three hosted adapters.
OPENAI_API_KEY=

# --- Voice activity detection / turn taking ---
VAD_THRESHOLD=0.014
VAD_START_FRAMES=3
VAD_END_SILENCE_MS=650
VAD_PRE_ROLL_MS=300
VAD_MAX_UTTERANCE_MS=30000
BROWSER_TRANSCRIPT_TIMEOUT_S=4

# --- Limits ---
MAX_HISTORY_MESSAGES=24
MAX_OUTPUT_QUEUE=256
STORE_RECENT_TURNS=500
